{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/bisp-payment-check-guide/:path*",
      "destination": "/bisp-balance-check-by-cnic-2026/",
      "statusCode": 301
    },
    {
      "source": "/bisp-8171-payment-balance-check-guide/:path*",
      "destination": "/bisp-balance-check-by-cnic-2026/",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.pakbenefits.com"
        }
      ],
      "destination": "https://pakbenefits.com/$1",
      "permanent": true
    }
  ]
}
