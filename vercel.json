    {
      "source": "/bisp-biometric-verification-failed-fingerprint-solution",
      "destination": "/bisp-biometric-verification-failed/",
      "statusCode": 301
    },
    {
      "source": "/bisp-biometric-verification-failed-fingerprint-solution/",
