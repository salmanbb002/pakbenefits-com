    {
      "@type": "HowTo",
      "@id": "https://pakbenefits.com/8171-check-online-kaise-karein/#howto",
      "name": "8171 Web Portal Par CNIC Check Karne Ka Tareeqa",
      "description": "BISP 8171 official web portal par apna CNIC check karne ka step-by-step tareeqa.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Official Portal Open Karein",
          "text": "Browser mein https://8171.bisp.gov.pk/ official URL open karein.",
          "position": 1
        },
        {
          "@type": "HowToStep",
          "name": "13-Digit CNIC Enter Karein",
          "text": "Pehle khane mein mustahiq khatoon ka 13-hinson ka CNIC number bina kisi dash ya space ke darj karein.",
          "position": 2
        },
        {
          "@type": "HowToStep",
          "name": "Captcha Code Aur Submit",
          "text": "Dusray khane mein 4-digit security code likhein aur Maloom Karein ke green button par click karein.",
          "position": 3
        }
      ]
    },
