    {
      "@type": "HowTo",
      "@id": "https://example.com/sindh-hari-card-scheme-2026-online-apply-eligibility/#howto",
      "name": "How to Apply for the Sindh Benazir Hari Card Online",
      "description": "Step-by-step guide to register on benazirharicard.gos.pk with Form VII land records.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Access BHC Registration Portal",
          "text": "Go to benazirharicard.gos.pk and select Farmer Registration to verify your CNIC via SMS OTP."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Enter Geographic and Land Records",
          "text": "Select your District, Taluka, and Deh, then enter your total cultivable acreage and Form VII registry number."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Upload Required Documents",
          "text": "Upload scanned copies of your CNIC front/back and attested Form VII land record or tenant affidavit."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Collect Biometric Card from Sindh Bank",
          "text": "Receive SMS notification and collect your activated biometric ATM card at the designated Sindh Bank branch."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://example.com/sindh-hari-card-scheme-2026-online-apply-eligibility/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the official website for Sindh Benazir Hari Card online registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The official web portal for online registration and status verification is https://www.benazirharicard.gos.pk."
          }
        },
        {
          "@type": "Question",
          "name": "What is the landholding limit to be eligible for the Hari Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The program primarily targets smallholder farmers and land cultivators holding between 1 and 25 acres of cultivable agricultural land in Sindh."
          }
        },
        {
          "@type": "Question",
          "name": "Can landless tenant farmers (Haris) apply for the Benazir Hari Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, registered tenant farmers (Haris) and sharecroppers can apply by submitting a verified tenancy agreement signed by the landowner and attested by the local Mukhtiarkar / Tapedar."
          }
        },
        {
          "@type": "Question",
          "name": "What is Form VII and why is it necessary for registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Form VII is the official revenue record (Khatoni/Deh record) issued by the Mukhtiarkar office that legally certifies agricultural land ownership and acreage in Sindh."
          }
        },
        {
          "@type": "Question",
          "name": "Which bank issues the Hari Card ATM card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Benazir Hari Card is issued and managed through Sindh Bank Limited, enabling direct biometric cash withdrawals across 1Link ATM networks."
          }
        },
        {
          "@type": "Question",
          "name": "What subsidies are provided to cardholders in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cardholders receive direct financial subsidies on DAP and Urea fertilizers, subsidized certified crop seeds, up to 80% grants for solar tube wells, interest-free seasonal credit, and crop disaster insurance."
          }
        },
        {
          "@type": "Question",
          "name": "Is there any registration fee for the Benazir Hari Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, registration for the Benazir Hari Card is completely free of charge across both online portals and physical Agriculture Department offices."
          }
        },
        {
          "@type": "Question",
          "name": "How do I check my Benazir Hari Card application status?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can check your application status by logging into your candidate profile at benazirharicard.gos.pk using your CNIC or by inquiring at your local Taluka Agriculture Extension Office."
          }
        },
        {
          "@type": "Question",
          "name": "How does the 80% Solar Tube Well subsidy work with the Hari Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Registered cardholders with verified land and existing agricultural tubewells can apply for solar conversion grants, where the Sindh Government funds 80% of the equipment and installation costs."
          }
        },
        {
          "@type": "Question",
          "name": "What is the official helpline number for Sindh Hari Card assistance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Farmers can contact the official helpline at 0311-1646111 or visit the nearest District Agriculture Extension Directorate for assistance."
          }
        }
      ]
    }
