      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the subsidy amount under the CM Punjab Green Tractor Scheme 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Punjab government provides a flat subsidy of Rs. 1,000,000 (10 Lakh PKR) per tractor directly toward the ex-factory invoice of 9,500 new green tractors."
          }
        },
        {
          "@type": "Question",
          "name": "How much land is required to be eligible for the Green Tractor Scheme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Farmers must own between 1 acre and 50 acres of agricultural land in Punjab, verified digitally through the Punjab Land Records Authority (PLRA) database."
          }
        }
      ]
    }
