    {
      "@type": "HowTo",
      "@id": "https://pakbenefits.com/fuel-scheme-rs-100-per-litre-petrol-relief-guide/#howto",
      "name": "How to Register and Claim the Rs. 100 Per Litre Petrol Relief in Pakistan",
      "description": "Step-by-step instructions to register your vehicle via SMS to 9771, generate a digital fuel token, and claim the Rs. 100/litre discount at petrol stations.",
      "totalTime": "PT15M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Confirm SIM Ownership Under Your CNIC",
          "text": "Dial *#66# or text your CNIC to 668 to confirm that your mobile SIM card is biometrically registered under your own name.",
          "url": "https://pakbenefits.com/fuel-scheme-rs-100-per-litre-petrol-relief-guide/#step-1"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Retrieve Vehicle Registration Details",
          "text": "Check your vehicle registration book or smart card to obtain your exact plate number, province of registration, and registration date.",
          "url": "https://pakbenefits.com/fuel-scheme-rs-100-per-litre-petrol-relief-guide/#step-2"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Send Registration SMS to 9771",
          "text": "Send an SMS to 9771 formatted as: REG [13-Digit CNIC] [Plate Number] [Province Code] [Registration Date DDMMYYYY].",
          "url": "https://pakbenefits.com/fuel-scheme-rs-100-per-litre-petrol-relief-guide/#step-3"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Generate a Digital Fuel Token",
          "text": "Before visiting a petrol pump, text TOK to 9771 to receive your 8-digit digital token valid for 24 hours.",
          "url": "https://pakbenefits.com/fuel-scheme-rs-100-per-litre-petrol-relief-guide/#step-4"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Redeem the Discount at the Pump",
          "text": "Present the digital token to the pump attendant at any participating fuel station to have Rs. 100/litre deducted directly at the point of sale.",
          "url": "https://pakbenefits.com/fuel-scheme-rs-100-per-litre-petrol-relief-guide/#step-5"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://pakbenefits.com/fuel-scheme-rs-100-per-litre-petrol-relief-guide/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Fuel Scheme Rs. 100 Per Litre Petrol Relief?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Fuel Scheme Rs. 100 Per Litre Petrol Relief is a targeted federal subsidy providing a direct discount of Rs. 100 per litre on petrol for eligible motorcycles, three-wheelers, and small cars up to 800cc. Funded by a Rs. 76.73 billion grant approved by the Economic Coordination Committee, the program is administered by the Petroleum Division using the digital Fuel Pass System."
          }
        },
        {
          "@type": "Question",
          "name": "How do I register for the Fuel Relief Scheme via SMS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To register, send an SMS to 9771 formatted as REG [CNIC] [Vehicle Plate] [Province Code] [Registration Date DDMMYYYY] using a mobile SIM registered in your own name. For example, text REG 3520112345671 LEM9821 P 14052017 to 9771 to initiate automated verification against provincial excise records."
          }
        },
        {
          "@type": "Question",
          "name": "What is the exact SMS format to send to 9771?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The exact format is REG [13-Digit CNIC without dashes] [Plate Number without spaces] [Province Code] [Registration Date in DDMMYYYY format]. Ensure each parameter is separated by a single space and that province codes use standard initials: P for Punjab, S for Sindh, K for KPK, B for Balochistan, I for Islamabad, A for AJK, or G for Gilgit-Baltistan."
          }
        },
        {
          "@type": "Question",
          "name": "Which vehicles qualify for the Rs. 100/litre petrol subsidy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The subsidy applies to motorcycles and scooters of all engine displacements (70cc to 150cc), three-wheelers and auto-rickshaws, and passenger cars with engine displacement up to 800cc (including Suzuki Mehran, Suzuki Bolan, and 660cc Japanese Kei cars). Vehicles exceeding 800cc displacement, diesel vehicles, commercial buses, and trucks are strictly excluded."
          }
        },
        {
          "@type": "Question",
          "name": "My motorcycle was registered in 2008 — do I qualify under the expanded rules?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, your motorcycle qualifies because the Ministry of Energy officially relaxed the registration cutoff to January 1, 2006, on September 18, 2026. As long as your two-wheeler or three-wheeler was registered on or after January 1, 2006, and ownership is recorded under your CNIC in the excise database, your application will be approved."
          }
        },
        {
          "@type": "Question",
          "name": "How do I generate a digital fuel token using SMS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To generate a digital fuel token, send the word TOK via SMS to 9771 from your registered mobile phone number. The Fuel Pass System will return an SMS containing an 8-digit digital token valid for 24 hours, which you present to the petrol pump attendant before refueling."
          }
        },
        {
          "@type": "Question",
          "name": "How many tokens can I receive in a month?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Motorcycle and rickshaw owners receive four weekly tokens per month, with each token worth a flat discount of Rs. 500 on petrol purchases (up to 20 litres total). Small car owners receive three tokens per month, with each token covering a discount on 10 litres of petrol (up to 30 litres total)."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Fuel Relief Scheme linked to BISP or the NSER poverty score?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, the Fuel Relief Scheme is completely independent of BISP and requires no PMT poverty score or NSER survey. Eligibility is based entirely on registered vehicle ownership, meaning middle-income citizens who do not qualify for BISP cash assistance can freely receive the fuel subsidy."
          }
        },
        {
          "@type": "Question",
          "name": "Can I register more than one vehicle on a single CNIC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, the Fuel Pass System enforces a strict limit of one registered vehicle per CNIC. If you own both a motorcycle and an 800cc car, you must choose one vehicle to register under the scheme, as duplicate registrations under the same identity number are automatically rejected."
          }
        },
        {
          "@type": "Question",
          "name": "Does the subsidy apply to diesel vehicles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, the subsidy applies exclusively to petrol (motor gasoline) purchases and excludes high-speed diesel (HSD) entirely. Because eligible vehicle categories—motorcycles, rickshaws, and small cars up to 800cc—operate primarily on petrol, diesel is omitted from the federal relief grant."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if a petrol station has no internet connection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If a petrol pump experiences internet connectivity failure, the attendant can validate your token using the official Offline SMS Protocol. The attendant texts your token code and CNIC from their registered merchant SIM directly to 9771, receiving an instant validation approval code without requiring internet access."
          }
        },
        {
          "@type": "Question",
          "name": "Are there any registration fees or SMS charges for sending messages to 9771?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, registration and token requests to 9771 are 100% free of charge. Under directives from the Pakistan Telecommunication Authority (PTA), all cellular operators have zero-rated the 9771 shortcode, ensuring no balance or tax is deducted from your mobile account."
          }
        }
      ]
    },
