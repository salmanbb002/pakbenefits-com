    {
      "@type": "HowTo",
      "@id": "https://pakbenefits.com/prime-minister-youth-loan-scheme-2026/#howto",
      "name": "How to Apply Online for the Prime Minister Youth Loan Scheme via pmyp.gov.pk",
      "description": "Step-by-step instructions to register, select bank, upload feasibility, and submit an online application for the Prime Minister Youth Loan Scheme 2026.",
      "totalTime": "PT25M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Pre-Registration and CNIC Verification",
          "text": "Visit https://pmyp.gov.pk/ and navigate to the application form. Enter your 13-digit CNIC number and issuance date. Complete the live NADRA Verisys identity check and enter the OTP sent to your registered mobile number."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Select Loan Tier, Category, and Participating Bank",
          "text": "Select whether you are applying as a New Startup or Existing Business. Choose your loan tier (Tier 1 up to Rs 0.5M, Tier 2 up to Rs 1.5M, or Tier 3 up to Rs 7.5M). Select your preferred participating commercial or Islamic bank branch."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Enter Business Feasibility and Reference Details",
          "text": "Provide business sector information, address, projected capital expenditures, and operational working capital. Enter realistic monthly revenue estimates and input CNIC and contact details for two non-dependent personal references."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Review, Pay Fee, Submit, and Track",
          "text": "Review your application form thoroughly. Pay the Rs. 100 non-refundable processing fee, submit the form online, and save the Application Reference Number (ARN) received via SMS to monitor tracking status."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://pakbenefits.com/prime-minister-youth-loan-scheme-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the maximum loan amount available under the Prime Minister Youth Loan Scheme 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The maximum loan amount available under the scheme is Rs. 7,500,000 (7.5 Million) under Tier 3. Tier 1 offers up to Rs. 500,000, while Tier 2 provides financing between Rs. 500,001 and Rs. 1,500,000."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Tier 1 PM Youth Loan genuinely 0% interest-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Tier 1 loans up to Rs. 500,000 carry a 0% markup rate, making them completely interest-free for the borrower. The federal government covers the markup cost through direct subsidies paid to participating microfinance institutions and banks."
          }
        },
        {
          "@type": "Question",
          "name": "What is the age limit to apply for the PM Youth Loan Scheme in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The general age limit is 21 to 45 years for standard business and agricultural financing. However, for IT and e-commerce-related businesses, the minimum age limit is lowered to 18 years, provided the applicant holds at least a Matriculation certificate."
          }
        },
        {
          "@type": "Question",
          "name": "Can government employees apply for the Prime Minister Youth Loan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, government employees are strictly ineligible to apply for the Prime Minister Youth Loan Scheme. This exclusion applies to permanent, contractual, and semi-government public sector employees to prevent conflicts of interest."
          }
        },
        {
          "@type": "Question",
          "name": "What collateral is required for Tier 1 and Tier 2 loans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tier 1 and Tier 2 loans do not require physical property collateral or asset pledges; they are disbursed as clean financing based on the personal guarantee of the borrower. Tier 3 loans (above Rs 1.5M up to Rs 7.5M) require tangible collateral as per the lending bank’s credit policy."
          }
        },
        {
          "@type": "Question",
          "name": "How much equity must a borrower contribute for a new business startup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For new startups, borrowers must contribute 10% equity for Tier 1 and Tier 2 loans (90:10 debt-to-equity ratio) and 20% equity for Tier 3 loans (80:20 debt-to-equity ratio). Existing businesses require 0% borrower equity across all tiers."
          }
        },
        {
          "@type": "Question",
          "name": "Can women entrepreneurs apply, and is there a dedicated quota?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, women entrepreneurs are encouraged to apply, and the government enforces a mandatory 25% quota dedicated to female business owners across all three tiers. Over 104,000 women have already secured financing through this channel."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take for a PM Youth Loan application to be processed and approved?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The complete processing and verification cycle typically takes between 30 and 45 business days from the date of online submission. Processing times vary depending on the chosen bank, field verification schedules, and credit checks."
          }
        },
        {
          "@type": "Question",
          "name": "Can I apply for the PM Youth Loan if I already have an active loan with another bank?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, you can apply if you have an active bank loan, provided your existing loan has an impeccable repayment record with zero overdue payments on your E-CIB report, and your total monthly debt payments do not exceed 40% to 50% of your net income."
          }
        },
        {
          "@type": "Question",
          "name": "Can I edit my PM Youth Loan application form after submitting it on pmyp.gov.pk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, once an application is submitted through the official portal, it cannot be modified or edited by the applicant. You must review all personal, financial, and banking details thoroughly before clicking the final submit button."
          }
        },
        {
          "@type": "Question",
          "name": "Which banks are processing Prime Minister Youth Loan Scheme applications in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Over 15 participating financial institutions process applications, including Allied Bank Limited (ABL), Bank of Punjab (BOP), JS Bank, Al Baraka Bank, Habib Bank Limited (HBL), National Bank of Pakistan (NBP), Meezan Bank, and specialized microfinance institutions like Akhuwat and NRSP."
          }
        },
        {
          "@type": "Question",
          "name": "Can the loan be used to purchase a commercial vehicle or agricultural machinery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the facility can finance agricultural machinery, solar tube wells, and locally manufactured commercial vehicles. However, individual borrowers are restricted to financing a single commercial vehicle, unless they operate an established food franchise or distribution business."
          }
        }
      ]
    },
