    {
      "@type": "HowTo",
      "name": "How to Verify BISP Taleemi Wazaif 70% Attendance Rule Stoppage",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Obtain Verification Slip",
          "text": "Get the official BISP Wazaif Verification Slip from Tehsil Office or 8171 portal."
        },
        {
          "@type": "HowToStep",
          "name": "School Endorsement",
          "text": "Present the slip to school principal for attendance record and rubber stamp."
        },
        {
          "@type": "HowToStep",
          "name": "Submit to Tehsil Office",
          "text": "Submit stamped slip with mother CNIC and child B-Form at BISP desk."
        },
        {
          "@type": "HowToStep",
          "name": "Check Online Status",
          "text": "Verify status on 8171 web portal after 7 to 10 working days."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What happens if my child's attendance is exactly 69%?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If attendance is below 70%, the BISP automated system automatically blocks the quarterly stipend."
          }
        },
        {
          "@type": "Question",
          "name": "How can I check BISP Taleemi Wazaif attendance status online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can check stipend eligibility by entering the mother's 13-digit CNIC on the official 8171 web portal (8171.bisp.gov.pk)."
          }
        }
      ]
    }
