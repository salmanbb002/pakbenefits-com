      "@type": "HowTo",
      "@id": "https://pakbenefits.com/fake-8171-sms-check-complaint-pta-bisp-lottery-fraud-alert#howto",
      "name": "How to Report Fake 8171 SMS to PTA via SMS 9000",
      "description": "Step-by-step procedure to send fraudulent mobile numbers and fake 8171 text messages to PTA for SIM blocking.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Open Scam Message",
          "text": "Open the fake 8171 BISP message received on your mobile handset."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Copy Scammer Details",
          "text": "Copy the scammer's 11-digit mobile phone number and the complete message text."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Compose Message to 9000",
          "text": "Type the scammer's mobile number, add a space, paste the fake message text, and send to 9000."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Receive Confirmation",
          "text": "Wait for PTA's automated SMS confirmation flagging the number for SIM blocking."
