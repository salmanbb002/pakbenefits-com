    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How do I check my BISP 8171 eligibility?", "acceptedAnswer": { "@type": "Answer", "text": "Send your 13-digit CNIC to 8171 by SMS, enter it at the 8171 web portal, or visit a BISP Tehsil office in person — all three return the same status." } },
        { "@type": "Question", "name": "Can I check BISP eligibility without internet?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Send your CNIC as a plain SMS to 8171 from your own mobile number; no data connection or smartphone is required." } },
        { "@type": "Question", "name": "Is checking BISP eligibility free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, on all three official methods. Standard SMS charges from your own network may apply to the text message itself, but the service is free." } },
        { "@type": "Question", "name": "What does 'survey required' mean when I check my status?", "acceptedAnswer": { "@type": "Answer", "text": "It means a record exists for your household, but BISP needs to verify or update it — usually through a fresh Tehsil office visit — before a final eligibility status can be confirmed." } },
        { "@type": "Question", "name": "What does 'no record found' mean?", "acceptedAnswer": { "@type": "Answer", "text": "No NSER survey has ever been completed for that CNIC, so there's nothing yet to check for eligibility against; you'd need to register first." } },
        { "@type": "Question", "name": "Why do I get different results from the portal and SMS?", "acceptedAnswer": { "@type": "Answer", "text": "Both draw on the same underlying NSER/PMT record, so a genuine difference is rare — if it happens, treat it as a sign to confirm your status in person at a Tehsil office." } },
        { "@type": "Question", "name": "How long does an SMS eligibility reply take?", "acceptedAnswer": { "@type": "Answer", "text": "Typically a few minutes, though it can take longer during high-traffic periods after a public announcement." } },
        { "@type": "Question", "name": "Do I need my original CNIC to check online or by SMS?", "acceptedAnswer": { "@type": "Answer", "text": "No — you only need to know the 13-digit number. An original CNIC is only needed if you visit a Tehsil office in person." } },
        { "@type": "Question", "name": "Can someone else check my eligibility on my behalf?", "acceptedAnswer": { "@type": "Answer", "text": "The portal and SMS only need the CNIC number, so technically yes, but BISP advises against sharing your CNIC with unofficial helpers given the scam risk around this service." } },
        { "@type": "Question", "name": "What if the 8171 portal shows an error or won't load?", "acceptedAnswer": { "@type": "Answer", "text": "It's usually temporary server load; wait and try again later. Confirm you're using the genuine bisp.gov.pk address before assuming your CNIC is the problem." } },
        { "@type": "Question", "name": "Does checking my eligibility affect my application or record in any way?", "acceptedAnswer": { "@type": "Answer", "text": "No — checking your status is a read-only lookup against your existing NSER record; it doesn't submit a new application or change your data." } },
        { "@type": "Question", "name": "How do I actually find out why I'm not eligible?", "acceptedAnswer": { "@type": "Answer", "text": "The check tells you the outcome, not the reason. See our eligibility criteria guide for the PMT cutoff and common disqualifying factors that decide the 'why.'" } }
      ]
    }
  ]
