    {
      "@type": "HowTo",
      "name": "How to Activate Your Kisan Card at a Bank of Punjab ATM",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Insert Kisan Card",
          "text": "Insert your Kisan Card into any Bank of Punjab ATM machine."
        },
        {
          "@type": "HowToStep",
          "name": "Receive and Enter OTP",
          "text": "Check your registered mobile phone for a 6-digit OTP code and enter it on the ATM screen."
        },
        {
          "@type": "HowToStep",
          "name": "Set 4-Digit PIN",
          "text": "Choose and confirm your confidential 4-digit secret ATM PIN on the keypad."
        }
