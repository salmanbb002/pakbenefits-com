      "@type": "HowTo",
      "name": "How to Apply Online for Apni Chhat Apna Ghar Scheme",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Register on ACAG Portal",
          "text": "Visit acag.punjab.gov.pk and create an account with your CNIC and phone number."
        },
        {
          "@type": "HowToStep",
          "name": "Complete Socio-Economic Profile",
          "text": "Enter family income and link your PSER reference number."
        },
        {
          "@type": "HowToStep",
          "name": "Upload Land Ownership Documents",
          "text": "Upload scanned copies of Fard Malkiat/Registry and photos of the vacant plot."
        },
        {
          "@type": "HowToStep",
          "name": "Submit and Track Application",
          "text": "Submit application and monitor status using your unique ACAG tracking ID."
        }
      ]
