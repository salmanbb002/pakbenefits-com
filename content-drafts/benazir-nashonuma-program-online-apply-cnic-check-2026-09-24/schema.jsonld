    {
      "@type": "HowTo",
      "@id": "https://example.com/benazir-nashonuma-program-online-apply-cnic-check/#howto",
      "name": "How to Check Benazir Nashonuma Eligibility and Register",
      "description": "Step-by-step procedure to check household eligibility on 8171 portal and register at a hospital facilitation desk.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Verify BISP Status on 8171 Web Portal",
          "text": "Visit 8171.bisp.gov.pk, enter your 13-digit CNIC and captcha code to verify active household eligibility under Benazir Kafaalat."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Assemble Mandatory Original Documents",
          "text": "Gather the mother's original CNIC, the child's NADRA B-Form, the child's EPI immunization card, and proof of pregnancy."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Visit Nearest DHQ/THQ Nashonuma Facilitation Center",
          "text": "Go to the government hospital facilitation counter for physical health checkups, mid-upper arm circumference measurement, and biometric registration."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Collect Specialized Nutritious Food & Await Quarterly Cash",
          "text": "Receive 90-day Wawa Mum or Maamta nutritional sachets and collect quarterly stipend via partner bank biometric POS."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://example.com/benazir-nashonuma-program-online-apply-cnic-check/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I check my Benazir Nashonuma status online using my CNIC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, you can check your base household eligibility online by entering your 13-digit CNIC number at 8171.bisp.gov.pk or by sending an SMS to 8171. However, full medical and nutritional registration for Nashonuma requires a physical visit to a facilitation center at a DHQ or THQ hospital."
          }
        },
        {
          "@type": "Question",
          "name": "How much money is given in the Benazir Nashonuma Program in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eligible beneficiaries receive Rs 2,500 per quarter for pregnant and lactating mothers, Rs 2,500 per quarter for a male child, and Rs 3,000 to Rs 3,500 per quarter for a female child. Each quarterly installment includes an integrated Rs 500 travel allowance."
          }
        },
        {
          "@type": "Question",
          "name": "Who is eligible to enroll in the Nashonuma Program?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Families currently registered with an active Benazir Kafaalat status and a PMT poverty score of 32 or below are eligible. Within those households, pregnant women, nursing mothers, and children under two years of age qualify directly."
          }
        },
        {
          "@type": "Question",
          "name": "Can a mother not registered under BISP Kafaalat apply for Nashonuma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, active registration under the Benazir Kafaalat Program is a strict prerequisite for Nashonuma enrollment. Unregistered mothers must first complete the Dynamic Registry survey at their local BISP Tehsil office to determine Kafaalat eligibility."
          }
        },
        {
          "@type": "Question",
          "name": "What documents are required to register at the hospital facilitation desk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Applicants must bring the mother's original NADRA CNIC, the child's original NADRA B-Form, the child's EPI immunization card, and hospital antenatal health records for pregnant women. All documents must be original physical copies."
          }
        },
        {
          "@type": "Question",
          "name": "Where are Benazir Nashonuma Facilitation Centers located?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nashonuma Facilitation Centers are established inside Tehsil Headquarter (THQ) and District Headquarter (DHQ) government hospitals across all 156 districts in Pakistan."
          }
        },
        {
          "@type": "Question",
          "name": "Why is the stipend higher for a female child?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Government of Pakistan provides a higher stipend for female infants (Rs 3,000–3,500 vs Rs 2,500) to incentivize families to provide equal healthcare, immunization, and nutritional attention to girl children."
          }
        },
        {
          "@type": "Question",
          "name": "What is Specialized Nutritious Food (SNF) and is it free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Specialized Nutritious Food includes fortified sachets (Wawa Mum for infants and Maamta for mothers) designed to prevent stunting and wasting. These sachets are distributed 100% free of charge at facilitation centers during quarterly checkups."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if I miss a scheduled hospital checkup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Missing a scheduled health examination or vaccination milestone will temporarily freeze your upcoming quarterly cash transfer. The payment is released once the beneficiary completes the required clinical checkup and updates their compliance record."
          }
        },
        {
          "@type": "Question",
          "name": "How do I report an agent demanding money for Nashonuma registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can report fraudulent agents and extortion attempts by calling the official BISP toll-free helpline at 0800-26477 or by filing an official complaint at your nearest district BISP office."
          }
        }
      ]
    }
  ]
