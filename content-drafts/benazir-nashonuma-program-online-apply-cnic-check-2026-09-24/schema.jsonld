    {
      "@type": "FAQPage",
      "@id": "https://pakbenefits.com/bisp-schemes/benazir-nashonuma-program-online-apply-cnic-check/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can any woman in Pakistan apply for the Benazir Nashonuma Program?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, registration is strictly restricted to pregnant women and mothers of children under 2 years who belong to families registered with a BISP Proxy Means Test (PMT) poverty score of 32 or below."
          }
        },
        {
          "@type": "Question",
          "name": "How much total money is given for a newborn baby girl under Nashonuma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A female child receives Rs 3,000 per month (disbursed as Rs 9,000 per quarter) from birth until she reaches 23 months of age, providing up to Rs 72,000 in direct nutrition cash support over two years."
          }
        },
        {
          "@type": "Question",
          "name": "Is there an online registration form to download for Benazir Nashonuma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, there is no downloadable online registration form. Registration requires physical clinical screening, biometric verification, and anthropometric measurement at a government THQ or DHQ hospital Nashonuma Facilitation Center."
          }
        },
        {
          "@type": "Question",
          "name": "What is Wawa Mum and is it given free of charge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wawa Mum is a specialized, nutrient-dense lipid paste fortified with essential micronutrients, vitamins, and minerals provided completely free of cost to enrolled mothers and infants to prevent stunting and wasting."
          }
        },
        {
          "@type": "Question",
          "name": "Can a mother receive both BISP Kafalat and Benazir Nashonuma cash simultaneously?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, an eligible mother receives her regular BISP Kafalat quarterly stipend (Rs 13,500) alongside her separate Nashonuma nutrition cash grants (Rs 2,500 to Rs 3,000 monthly) without any deduction."
          }
        },
        {
          "@type": "Question",
          "name": "Where are Benazir Nashonuma Facilitation Centers located?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nashonuma Facilitation Centers (NFCs) are established in designated wards inside all District Headquarter (DHQ) and Tehsil Headquarter (THQ) Government Hospitals across Pakistan."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if I miss a scheduled vaccination or hospital checkup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Missing a mandatory ANC checkup or EPI vaccination milestone results in a temporary freeze on your upcoming quarterly cash stipend until your visit is verified and updated in the clinic database."
          }
        },
        {
          "@type": "Question",
          "name": "Is a NADRA B-Form mandatory to register an infant in Nashonuma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, the child’s NADRA Child Registration Certificate (B-Form) is mandatory because it legally links the child’s identity to the mother’s CNIC in the central BISP registry."
          }
        },
        {
          "@type": "Question",
          "name": "Which bank distributes Benazir Nashonuma cash payments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Payments are disbursed biometrically through partner banks: Bank Alfalah in Khyber Pakhtunkhwa, Gilgit-Baltistan, and AJK; and Habib Bank Limited (HBL / Konnect) across Punjab, Sindh, and Balochistan."
          }
        },
        {
          "@type": "Question",
          "name": "Can a pregnant woman register if she is expecting her third child?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, pregnant women from qualifying low-income households can register for each pregnancy and enroll up to two concurrent children under two years of age."
          }
        },
        {
          "@type": "Question",
          "name": "How can I lodge a complaint if an agent demands a deduction from my Nashonuma grant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never pay any fee or deduction. Lodge an immediate complaint by calling the BISP toll-free helpline at 0800-26477 or visit the Assistant Director at your local BISP Tehsil Office with the retailer’s POS ID and receipt."
          }
        }
      ]
    }
  ]
