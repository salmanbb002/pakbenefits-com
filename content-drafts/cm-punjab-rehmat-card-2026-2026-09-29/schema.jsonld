    {
      "@type": "FAQPage",
      "@id": "https://example.com/cm-punjab-rehmat-card-2026#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the CM Punjab Rehmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The CM Punjab Rehmat Card is an official social protection grant initiated by Chief Minister Maryam Nawaz Sharif through the Punjab Zakat & Ushr Department. It delivers a one-time unconditional cash transfer of Rs 100,000 to impoverished Muslim widows and parentless orphans residing in Punjab to alleviate poverty and support essential family needs."
          }
        },
        {
          "@type": "Question",
          "name": "How much money is given under the CM Rehmat Card scheme in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eligible beneficiaries receive a one-time financial grant of Rs 100,000. The full amount is transferred without any service cuts, bank fees, or third-party agent charges through verified digital wallets."
          }
        },
        {
          "@type": "Question",
          "name": "Who is eligible for the Maryam Nawaz Rehmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eligibility is strictly restricted to deserving Muslim widows and parentless (double-parent) orphans who are permanent residents of Punjab. Applicants must qualify as Mustahiq-e-Zakat, be registered in the Punjab Socio-Economic Registry (PSER), and have valid civil credentials authenticated by NADRA."
          }
        },
        {
          "@type": "Question",
          "name": "Can single-parent orphans apply for the Rehmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, children with one surviving parent do not qualify under the dedicated orphan category. Program statutes mandate that orphan benefits are reserved exclusively for double-parent orphans who have lost both biological parents, though impoverished single mothers can apply directly under the widow quota."
          }
        },
        {
          "@type": "Question",
          "name": "Why were Rehmat Card payments stopped on September 18, 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Disbursements were temporarily paused on September 18, 2026, after fulfilling the inaugural Phase 1 target of 50,000 beneficiaries and to conduct a statewide audit of payment reconciliation. The pause ensures technical improvements in biometric systems before rolling out Phase 2."
          }
        },
        {
          "@type": "Question",
          "name": "When will the CM Rehmat Card Phase 2 registration begin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Phase 2 Rollout 2026 is scheduled to open in late 2026 under an expanded provincial funding package. The reopening will be formally announced through the Punjab Zakat & Ushr Department portal and major media channels."
          }
        },
        {
          "@type": "Question",
          "name": "How can I apply for the CM Rehmat Card online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eligible citizens can apply online by visiting the official portal at rahmatcard.punjab.gov.pk or by downloading the 'CM Punjab Rahmat Card' app developed by PITB from the Google Play Store. Both platforms require an identity card number and active mobile SIM authentication."
          }
        },
        {
          "@type": "Question",
          "name": "How do I check my Rehmat Card application status using my CNIC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To check your application status, navigate to rahmatcard.punjab.gov.pk, input your 13-digit NADRA CNIC without spaces or dashes, and click 'Check Status.' You can also receive live updates by calling the provincial helpline at Helpline 1077."
          }
        },
        {
          "@type": "Question",
          "name": "Is there any fee for registering for the CM Punjab Rehmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, registration for the program is 100% free across all web, mobile, and physical office channels. Citizens should never pay private agents or middlemen claiming to expedite approvals or charge processing fees."
          }
        },
        {
          "@type": "Question",
          "name": "Can beneficiaries of the CM Himmat Card also apply for the Rehmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, beneficiaries receiving stipends from parallel provincial welfare initiatives like the CM Himmat Card Scheme are excluded from concurrent enrollment. The provincial registry automatically filters duplicate beneficiaries across programs to ensure equitable fund distribution."
          }
        }
      ]
    },
