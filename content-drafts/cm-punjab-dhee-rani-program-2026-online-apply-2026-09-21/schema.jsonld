        {
          "@type": "Question",
          "name": "What is the cash grant amount given under the CM Punjab Dhee Rani Program?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every eligible bride receives a financial wedding gift (Salami) of Rs. 100,000 disbursed directly through a dedicated Bank of Punjab ATM card."
          }
        },
        {
          "@type": "Question",
          "name": "What is the age limit for brides in the Dhee Rani Program?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The bride must be between 18 and 40 years old at the time of application submission."
          }
        }
      ]
