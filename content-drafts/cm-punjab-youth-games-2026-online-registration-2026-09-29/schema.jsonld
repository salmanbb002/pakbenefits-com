    {
      "@type": "HowTo",
      "@id": "https://example.com/cm-punjab-youth-games-2026/#howto",
      "name": "How to Register for CM Punjab Youth Games 2026 Online",
      "description": "Step-by-step guide to complete online registration for the CM Punjab Youth Games 2026 via youthgames.punjab.gov.pk.",
      "totalTime": "PT10M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Access the Central Portal",
          "text": "Navigate to youthgames.punjab.gov.pk and click the green Register Now button."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Select Academic Category",
          "text": "Choose your participation tier (Middle School, Secondary School, College, University, or Special Persons)."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Link Educational Institution",
          "text": "Search your school, college, or university name from the directory or use the Enter Manually option if not listed."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Enter Personal Information",
          "text": "Provide your full name, father's name, active mobile number, division, district, tehsil, and union council."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Enter NADRA Identity Details",
          "text": "Enter your 13-digit NADRA B-Form or CNIC number and date of birth exactly as shown on the official identity document."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Select Sport & Uniform Sizing",
          "text": "Pick your chosen sport discipline and select your official sports kit shirt size and jogger shoe size."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Upload Passport Photograph",
          "text": "Attach a passport-style portrait photograph in JPG or PNG format ensuring file size is under 256 KB."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Submit Registration",
          "text": "Solve the security captcha sum, check the legal declaration box, and click Submit Registration."
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Save Your Track ID",
          "text": "Save and screenshot your unique alphanumeric Track ID slip for trial admission and verification."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://example.com/cm-punjab-youth-games-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the official registration website for the CM Punjab Youth Games 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The official website for registration is youthgames.punjab.gov.pk. Applicants must submit their details directly through this portal, as no offline paper applications are accepted."
          }
        },
        {
          "@type": "Question",
          "name": "What is the last date to apply online for Punjab Youth Games 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The last date for online registration is September 30, 2026. Sports authorities extended the original September 25 deadline to allow broader student enrollment."
          }
        },
        {
          "@type": "Question",
          "name": "Is there any fee to register or participate in the trials?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, registration and trial participation are completely free of cost. The Government of Punjab does not charge any application or testing fees."
          }
        },
        {
          "@type": "Question",
          "name": "Can private school, college, and university students apply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, students enrolled in registered private schools, private colleges, and private chartered universities are fully eligible to compete. They must select their institution during online registration."
          }
        },
        {
          "@type": "Question",
          "name": "Can students of religious seminaries (deeni madaris) participate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, students of registered deeni madaris across Punjab are eligible to participate. They can register under the secondary school bracket (under 17) or college bracket (under 21)."
          }
        },
        {
          "@type": "Question",
          "name": "What is the maximum age limit for university students?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "University students must be between 17 and 50 years of age, with birth dates falling between January 1, 1976, and December 31, 2009. This category accommodates undergraduate, postgraduate, and doctoral scholars."
          }
        },
        {
          "@type": "Question",
          "name": "What should I do if my school or college name is missing from the portal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If your educational institution is not listed in the automated drop-down menu, select the \"Enter Manually\" option on the form. Type your institution's complete official name and address to continue your application."
          }
        },
        {
          "@type": "Question",
          "name": "Why does the registration form reject my photograph upload?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The portal strictly rejects photograph files larger than 256 KB. If your image fails to upload, compress the photo file to under 256 KB in JPG or PNG format before resubmitting."
          }
        },
        {
          "@type": "Question",
          "name": "When will athlete trials be conducted across Punjab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Institutional sports trials will be conducted from October 7 to October 13, 2026. Physical evaluations will take place on institutional grounds under the supervision of designated sports officers."
          }
        },
        {
          "@type": "Question",
          "name": "How can a player dispute unfair trial results?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Players can submit an official complaint through the grievance portal located at youthgames.punjab.gov.pk/#grievance. Provide your Track ID and district details to request a review of your trial markings by the district committee."
          }
        },
        {
          "@type": "Question",
          "name": "What is the total cash prize pool for the Punjab Youth Games 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The total cash prize pool allocated by the Government of Punjab is PKR 500 million. Cash rewards will be distributed to winners across district, divisional, and provincial stages."
          }
        }
      ]
    }
  ]
