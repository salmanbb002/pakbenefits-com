    {
      "@type": "HowTo",
      "name": "How to check your Himmat Card status online by CNIC",
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Open the DPMIS portal", "text": "Open dpmis.punjab.gov.pk on a phone or computer." },
        { "@type": "HowToStep", "position": 2, "name": "Go to Himmat Card verification", "text": "Go to the Himmat Card verification section." },
        { "@type": "HowToStep", "position": 3, "name": "Enter your CNIC", "text": "Type your 13-digit CNIC without dashes." },
        { "@type": "HowToStep", "position": 4, "name": "Submit", "text": "Submit to view your status." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Himmat Card?",
          "acceptedAnswer": { "@type": "Answer", "text": "It's a Punjab Social Welfare Department card giving eligible persons with disabilities Rs 10,500 every three months, administered through the DPMIS system." }
        },
        {
          "@type": "Question",
          "name": "How do I check my Himmat Card eligibility by CNIC?",
          "acceptedAnswer": { "@type": "Answer", "text": "Go to dpmis.punjab.gov.pk, open the Himmat Card verification section, enter your 13-digit CNIC without dashes, and submit — no account or password is needed for this check." }
        },
        {
          "@type": "Question",
          "name": "Is Himmat Card checked through 8171?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Neither official Punjab source for this program mentions 8171; that number belongs to BISP's own separate household-eligibility check." }
        },
        {
          "@type": "Question",
          "name": "What PMT score do I need for the Himmat Card?",
          "acceptedAnswer": { "@type": "Answer", "text": "Your BISP-issued Proxy Means Test score must be 45 or below. This is the same PMT figure BISP uses for its own programmes, not a separate disability-specific score." }
        },
        {
          "@type": "Question",
          "name": "Can I get a Himmat Card if I already receive BISP or Zakat?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Current BISP, PSPA, Zakat, or Bait ul Maal assistance disqualifies an applicant from the Himmat Card, according to the official eligibility criteria." }
        },
        {
          "@type": "Question",
          "name": "What does \"under review\" mean on my status check?",
          "acceptedAnswer": { "@type": "Answer", "text": "It means your record has been submitted but is still being processed by the Social Welfare Department; check again after some time rather than resubmitting your CNIC repeatedly." }
        },
        {
          "@type": "Question",
          "name": "How much does the Himmat Card pay, and how is it delivered?",
          "acceptedAnswer": { "@type": "Answer", "text": "Rs 10,500 every three months, paid onto a Bank of Punjab ATM card rather than handed out as cash at an office." }
        },
        {
          "@type": "Question",
          "name": "How do I check my Himmat Card balance?",
          "acceptedAnswer": { "@type": "Answer", "text": "Use your Bank of Punjab ATM card and PIN at any Bank of Punjab ATM's balance-inquiry option; this is separate from the CNIC-based DPMIS eligibility check." }
        },
        {
          "@type": "Question",
          "name": "How do I register if my CNIC shows \"not found\"?",
          "acceptedAnswer": { "@type": "Answer", "text": "Create a new account on dpmis.punjab.gov.pk with your CNIC, contact details, and a selected medical board for your disability assessment, then submit for review." }
        },
        {
          "@type": "Question",
          "name": "Can a child with a disability get a Himmat Card?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — a parent or guardian can apply and manage the card on the child's behalf; there's no separate age limit stated in the published criteria." }
        },
        {
          "@type": "Question",
          "name": "Is the Himmat Card program guaranteed to continue through 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "The official DPMIS FAQ describes the program as \"approved until June 2025\" with an extension pending review, so ongoing availability should be confirmed through official channels rather than assumed indefinitely." }
        },
        {
          "@type": "Question",
          "name": "Can I check my Himmat Card status without internet?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — call the 1312 helpline or visit your District Social Welfare Office in person with your original CNIC." }
        },
        {
          "@type": "Question",
          "name": "Is there a fee to check status or register?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Both the status check and registration are free; never pay anyone claiming to speed up or guarantee approval." }
        }
      ]
    }
  ]
