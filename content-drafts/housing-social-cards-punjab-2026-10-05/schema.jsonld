    {
      "@type": "HowTo",
      "@id": "TODO: https://yourdomain.com/housing-social-cards-punjab/#howto-pser",
      "name": "How to Register on PSER Portal (pser.punjab.gov.pk)",
      "description": "Step-by-step procedure to register household socio-economic data on the Punjab Socio-Economic Registry portal.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Visit Portal",
          "text": "Navigate to the official Punjab Socio-Economic Registry web portal at pser.punjab.gov.pk."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Create Account",
          "text": "Click on 'Register New Account' and enter your full name, mobile number, district, and 13-digit CNIC number."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "OTP Verification",
          "text": "Log into your dashboard using the SMS verification OTP sent to your registered mobile SIM."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Complete Household Survey",
          "text": "Fill in family member details, monthly household income, housing condition, and utility bill consumer numbers."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Submit & Track",
          "text": "Review entered data and submit to generate your unique PSER Registration Tracking ID."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "TODO: https://yourdomain.com/housing-social-cards-punjab/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the official portal to apply for Apni Chhat Apna Ghar housing scheme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The official portal for the Apni Chhat Apna Ghar scheme is acag.punjab.gov.pk. Applicants can log in using their 13-digit CNIC number to upload property ownership documents and track loan status."
          }
        },
        {
          "@type": "Question",
          "name": "How much quarterly financial assistance does the Himmat Card provide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Himmat Card provides a quarterly cash stipend of PKR 10,500 to eligible Persons with Disabilities in Punjab. Disbursements are made through Bank of Punjab ATMs using biometric verification."
          }
        },
        {
          "@type": "Question",
          "name": "How can farmers check their eligibility for the Punjab Kisan Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Farmers can check their Kisan Card eligibility by sending their 13-digit CNIC number via SMS to 8070. Alternatively, status details can be verified through local Tehsil Agriculture Department offices."
          }
        },
        {
          "@type": "Question",
          "name": "What plot sizes qualify for the Apni Chhat Apna Ghar housing loan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Urban residential plots up to 5 Marlas and rural plots up to 10 Marlas qualify for the interest-free housing loan. Applicants must hold clear legal land title (Fard Malkiyat)."
          }
        },
        {
          "@type": "Question",
          "name": "What is the maximum loan amount under Apni Chhat Apna Ghar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The maximum interest-free housing construction loan amount under Apni Chhat Apna Ghar is PKR 1.5 million. Repayment is structured over a 9-year tenure with monthly installments between PKR 4,700 and PKR 9,300."
          }
        },
        {
          "@type": "Question",
          "name": "Is PSER registration required to qualify for Punjab welfare cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, PSER registration on pser.punjab.gov.pk is compulsory for all Punjab welfare cards. The registry evaluates household poverty levels and calculates PMT scores required for eligibility."
          }
        },
        {
          "@type": "Question",
          "name": "How do industrial workers register for the PESSI Mazdoor Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Industrial workers can register for the Mazdoor Card through their registered employers on the PESSI online portal. Domestic workers can apply directly via the official Domestic Workers mobile app."
          }
        },
        {
          "@type": "Question",
          "name": "What assistance does the Dhee Rani Program offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Dhee Rani Program provides PKR 100,000 cash grant, essential household dowry items, and formal collective marriage arrangements for deserving brides in Punjab."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between SMS shortcode 8070 and 8171?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SMS 8070 is the official Punjab provincial government shortcode for Kisan Card and provincial relief schemes. SMS 8171 belongs to the federal Benazir Income Support Programme (BISP)."
          }
        },
        {
          "@type": "Question",
          "name": "Are there any application fees for Punjab housing and social security cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, all government card applications and PSER survey registrations are completely free. Citizens should never pay agent fees or unauthorized service charges to third parties."
          }
        }
      ]
    }
