    {
      "@type": "FAQPage",
      "@id": "https://pakbenefits.com/cm-punjab-himmat-card-online-apply-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I apply online for the CM Punjab Himmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Visit the official Punjab government portal at dpmis.punjab.gov.pk, create an account with your 13-digit CNIC, fill out your disability profile, upload your District Medical Board Disability Certificate and NADRA Special CNIC, and submit your application."
          }
        },
        {
          "@type": "Question",
          "name": "How much money is given under the Himmat Card in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eligible beneficiaries receive a quarterly stipend of Rs. 10,500 (Rs. 3,500 per month) credited directly into their Bank of Punjab account."
          }
        },
        {
          "@type": "Question",
          "name": "What is the maximum PMT score allowed for the Himmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The household Proxy Means Test (PMT) poverty score must be 45 or below in the BISP NSER database."
          }
        },
        {
          "@type": "Question",
          "name": "Can a person with a government job apply for the Himmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Applicants must be completely unemployed and officially assessed as Not Fit to Work by an authorized medical board."
          }
        },
        {
          "@type": "Question",
          "name": "Where can I get an official Disability Certificate in Punjab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You must visit your local District Social Welfare Office and be examined by the District Medical Board at the District Headquarter Hospital (DHQ)."
          }
        },
        {
          "@type": "Question",
          "name": "Which bank issues the Himmat ATM card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Bank of Punjab (BOP) is the official banking partner that issues the co-branded Himmat Card and handles biometric cash withdrawals."
          }
        },
        {
          "@type": "Question",
          "name": "What is the official helpline number for Himmat Card inquiries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can call the official Punjab Social Welfare helpline at 1312 for assistance regarding application status, medical boards, or card collection."
          }
        },
        {
          "@type": "Question",
          "name": "Is there any application fee for the Himmat Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Registration on the DPMIS portal and issuance of the Himmat Card are completely free of cost. Never pay any fee to agents."
          }
        },
        {
          "@type": "Question",
          "name": "Can I receive both BISP Kafaalat and Himmat Card at the same time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. To prevent duplicate government subsidies, Himmat Card rules require that the applicant is not an active recipient of other monthly government cash grants."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take for the Himmat Card to be issued after applying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Document verification and PMT cross-matching typically take 3 to 6 weeks. Approved applicants are notified via SMS to collect their ATM card from their designated BOP branch."
          }
        }
      ]
    }
  ]
