      "name": "How to Resolve BISP Biometric Verification Failure",
      "description": "Step by step procedure to get BISP Rs 13,500 payment when fingerprints fail at POS or ATM.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Clean and Moisturization",
          "text": "Wash hands thoroughly with soap, apply mild moisturizer or glycerine to make fingerprint ridges visible."
        },
        {
          "@type": "HowToStep",
          "name": "Try Alternative Fingers and Retailers",
          "text": "Try different fingers on the scanner or visit another HBL Connect / Bank Alfalah POS agent."
        },
        {
          "@type": "HowToStep",
          "name": "Update NADRA Biometrics",
          "text": "Visit nearest NADRA center to re-scan and update fingerprints in the central database."
        },
        {
          "@type": "HowToStep",
          "name": "Submit BISP Form B Manual Application",
          "text": "Fill Form B at BISP Tehsil office for Assistant Director approval of manual payment."
        }
      ]
