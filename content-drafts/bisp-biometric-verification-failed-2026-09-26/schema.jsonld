    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What should I do if BISP biometric verification fails at POS machine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sab se pehle hathon ko saaf aur moisturize karke baqi ungliyan try karein. Agar phir bhi verification na ho to NADRA center se biometrics update karwayen ya BISP Tehsil Office se Form B fill karein."
          }
        },
        {
          "@type": "Question",
          "name": "What is BISP Manual Payment Form B?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Form B ek zaroori Sarkari Application Form hai jo un BISP beneficiaries ke liye hota hai jinke fingerprints biometric machines par match nahi hote. Is form ke zariye manual payment ki manzoori milti hai."
          }
        },
        {
          "@type": "Question",
          "name": "How much payment is disbursed in the BISP Kafaalat scheme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BISP Kafaalat program ke teht 2026 mein har eligible khatoon ko Rs 13,500 ki quarterly installment ada ki ja rahi hai."
          }
        }
