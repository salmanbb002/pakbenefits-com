    {
      "@type": "HowTo",
      "name": "How to Transfer BISP Deceased Beneficiary Account & Register Death",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Register Death with NADRA",
          "text": "Obtain official NADRA Death Certificate and CNIC Cancellation Certificate."
        },
        {
          "@type": "HowToStep",
          "name": "Report to BISP Tehsil Office",
          "text": "Present cancellation certificates and FRC at BISP Helpdesk."
        },
        {
          "@type": "HowToStep",
          "name": "Conduct Dynamic Survey",
          "text": "Complete new NSER Dynamic Survey for eligible surviving female head."
        },
        {
          "@type": "HowToStep",
          "name": "Claim Accrued Payments",
          "text": "Activate biometric account and claim pending stipends via 8171 SMS."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can a husband receive his deceased wife's BISP Kafaalat payments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A husband cannot directly receive BISP Kafaalat cash payments unless he is the sole legal guardian of minor orphan children."
          }
        },
        {
          "@type": "Question",
          "name": "What happens to unpaid BISP stipends left in the account before death?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unpaid stipends that were disbursed prior to death can be claimed by legal heirs submitting a Succession Certificate at BISP Tehsil Office."
          }
        }
      ]
    }
  ]
