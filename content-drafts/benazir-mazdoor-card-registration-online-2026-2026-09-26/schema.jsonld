      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can an individual worker apply for the Benazir Mazdoor Card independently?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, registration requires verification through an employer registered with SESSI."
