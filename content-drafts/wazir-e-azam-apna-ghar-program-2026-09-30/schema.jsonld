    {
      "@type": "FAQPage",
      "@id": "https://example.com/wazir-e-azam-apna-ghar-program#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Wazir-e-Azam Apna Ghar Program?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is Pakistan's federal housing finance scheme, a markup subsidy and risk-sharing programme launched by Prime Minister Shehbaz Sharif on 30 April 2026 and regulated by the State Bank of Pakistan. It gives first-time buyers subsidised home loans through partner banks."
          }
        },
        {
          "@type": "Question",
          "name": "What is the maximum loan amount?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The maximum loan is Rs 10 million, offered in slabs of Rs 2.5 million, Rs 5 million, Rs 7.5 million and Rs 10 million. The slab you qualify for depends on your income, equity and the property value."
          }
        },
        {
          "@type": "Question",
          "name": "What is the markup rate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The markup is 5% fixed for the first 10 years, subsidised by the government. After year 10 it moves to 1-year KIBOR plus 3%, a market-linked rate, so your installment may change."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Apna Ghar Program interest-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. It carries a fixed 5% markup for the first decade, not zero interest. The interest-free scheme is the separate Punjab-only Apni Chhat Apna Ghar programme."
          }
        },
        {
          "@type": "Question",
          "name": "How much down payment do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You contribute 10% of the property value as equity, while the bank finances up to 90%. There is no processing fee and no prepayment penalty."
          }
        },
        {
          "@type": "Question",
          "name": "Who is eligible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Any resident Pakistani holding a valid CNIC — or an NRP with a NICOP or POC — who is a first-time homeowner with a stable, verifiable income and a clean credit history. Both salaried and self-employed applicants can apply."
          }
        },
        {
          "@type": "Question",
          "name": "What kind of property is covered?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A house of up to 10 marla (2,720 sq ft) or a flat of up to 1,500 sq ft, with no cap on price. You can buy a house or flat, buy a plot with construction, or build on a plot you already own."
          }
        },
        {
          "@type": "Question",
          "name": "Which banks offer the loan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Participating lenders include NBP, Bank of Punjab, Meezan Bank, HBL, Allied Bank, UBL, MCB, Bank Alfalah, Bank AL Habib, Faysal Bank, Askari Bank, Mobilink Bank, Standard Chartered and HBFC. From July 2026, eligible NBFCs and microfinance companies can also lend."
          }
        },
        {
          "@type": "Question",
          "name": "Can overseas Pakistanis apply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Non-Resident Pakistanis holding a NICOP can apply through the Roshan Apna Ghar track, which requires a Roshan Digital Account, with tenure extendable up to 25 years."
          }
        },
        {
          "@type": "Question",
          "name": "How do I apply online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Visit apnaghar.gov.pk, register with your CNIC and mobile number, complete the application form, upload your documents, choose a participating bank, and submit. You will receive a Tracking ID to monitor progress."
          }
        },
        {
          "@type": "Question",
          "name": "How long does approval take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Banks are mandated to complete approval within 15 working days of receiving a complete application. Delays can be escalated through the SBP complaint portal."
          }
        },
        {
          "@type": "Question",
          "name": "Is there any application fee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Application is free, with no processing fee and no prepayment penalty. Anyone charging a registration fee is running a fraud."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://example.com/wazir-e-azam-apna-ghar-program#howto",
      "name": "How to Apply for the Wazir-e-Azam Apna Ghar Program",
      "description": "Step-by-step procedure to apply for the Wazir-e-Azam Apna Ghar Program at apnaghar.gov.pk.",
      "totalTime": "PT30M",
      "estimatedCost": {
        "@type": "MonetaryAmount",
        "currency": "PKR",
        "value": "0"
      },
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Open the official portal",
          "text": "Go to apnaghar.gov.pk — the only official federal application portal."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Create your account",
          "text": "Register with your 13-digit CNIC, a mobile number registered in your own name, and an email address, then verify the SMS OTP and email link."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Complete the application form",
          "text": "Enter personal, income, employment and property details, then select your loan slab and preferred bank."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Upload documents",
          "text": "Attach clear scans of your CNIC, income proof, bank statements and property documents as PDF or JPG files."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Choose your bank",
          "text": "Pick from participating commercial banks, Islamic banks, HBFC, or eligible NBFCs and microfinance companies."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Submit and save your Tracking ID",
          "text": "Review, submit, and keep the Tracking ID; the bank will contact you within 3–5 working days."
        }
      ]
