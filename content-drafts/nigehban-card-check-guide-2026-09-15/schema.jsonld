    {
      "@type": "HowTo",
      "name": "How to Check Your Nigehban Card Status by CNIC",
      "step": [
        { "@type": "HowToStep", "name": "SMS method", "text": "Open your phone's messaging app, type your 13-digit CNIC without dashes, and send it to 8070 from any Pakistani network." },
        { "@type": "HowToStep", "name": "Portal method", "text": "Go to pser.punjab.gov.pk, enter your 13-digit CNIC, and submit the form to view your household's status." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the Nigehban Card the same as the CM Nigehban Card Program?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Punjab's own Special Monitoring Unit describes the \"CM Nigehban Card Program for Destitute and Vulnerable\" and the \"Nigehban Ramzan Package\" as the same initiative, even though both names circulate separately online." }
        },
        {
          "@type": "Question",
          "name": "Is the Nigehban Card the same as BISP's 8171 service?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. BISP is a separate federal programme with its own registry and its own 8171 number. The Nigehban Card draws instead on Punjab's own PSER data." }
        },
        {
          "@type": "Question",
          "name": "How do I check my Nigehban Card status?",
          "acceptedAnswer": { "@type": "Answer", "text": "Send your 13-digit CNIC by SMS to 8070, or enter your CNIC on the official portal at pser.punjab.gov.pk." }
        },
        {
          "@type": "Question",
          "name": "Why do some websites say the code is 9999 instead of 8070?",
          "acceptedAnswer": { "@type": "Answer", "text": "9999 is actually the code for a different, federal scheme — the PM Ramzan Relief Package. A minority of guides mislabel that code as Nigehban's own, and at least one also wrongly adds BISP's separate Kafaalat payment into the total." }
        },
        {
          "@type": "Question",
          "name": "How much money does the Nigehban Card provide?",
          "acceptedAnswer": { "@type": "Answer", "text": "Commonly reported figures put it at a one-time Rs 10,000 via an ATM-style card, plus a subsidized rashan package — though the exact rashan quantities are third-party reported, not confirmed on Punjab's own pages." }
        },
        {
          "@type": "Question",
          "name": "Do I need to register separately for the Nigehban Card?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. There is no separate Nigehban Card application form; eligibility is drawn entirely from your existing PSER household record, so registering with PSER (if you haven't already) is the actual prerequisite." }
        },
        {
          "@type": "Question",
          "name": "What is PSER, and how is it different from NSER?",
          "acceptedAnswer": { "@type": "Answer", "text": "PSER is the Punjab Socio-Economic Registry, Punjab's own provincial household-data survey. NSER is the federal registry BISP uses. They are run by different authorities and are not the same database." }
        },
        {
          "@type": "Question",
          "name": "Who is eligible for the Nigehban Card?",
          "acceptedAnswer": { "@type": "Answer", "text": "Reported criteria include Punjab residency, a valid CNIC, monthly household income under Rs 60,000, and a PMT score below 32, with priority often given to households already flagged through PSER or BISP as low-income." }
        },
        {
          "@type": "Question",
          "name": "Who is excluded from the Nigehban Card?",
          "acceptedAnswer": { "@type": "Answer", "text": "Regular government employees, households owning more than about two acres of agricultural land, and CNIC/SIM mismatches are the exclusions cited most consistently across sources." }
        },
        {
          "@type": "Question",
          "name": "What does \"under verification\" mean after I check?",
          "acceptedAnswer": { "@type": "Answer", "text": "It means your PSER record needs to be checked or updated before a final result is issued — it is not a rejection." }
        },
        {
          "@type": "Question",
          "name": "Is the Nigehban Card still open in September 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "The 2026 cycle's reported registration cutoff was mid-February 2026, ahead of that year's Ramadan, so the window described by most current guides has already closed as of this update." }
        },
        {
          "@type": "Question",
          "name": "Is there a fee to check or register for the Nigehban Card?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The check itself is free; only standard network SMS charges from your own provider may apply." }
        },
        {
          "@type": "Question",
          "name": "How will I receive the Nigehban Card payment?",
          "acceptedAnswer": { "@type": "Answer", "text": "Reported channels include HBL Konnect agents, UBL Omni centers, designated bank ATMs, and branchless banking agents, with CNIC verification required at collection." }
        }
      ]
    }
  ]
