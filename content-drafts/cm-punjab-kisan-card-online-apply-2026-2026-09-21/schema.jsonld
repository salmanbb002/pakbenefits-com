      "name": "How to Register for the CM Punjab Kisan Card via 8070 SMS",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Compose SMS with PKC Syntax",
          "text": "Open your messaging app on a SIM registered in your CNIC and type 'PKC [Space] 13-digit CNIC' without hyphens."
        },
        {
          "@type": "HowToStep",
          "name": "Send SMS to 8070",
          "text": "Send the message to official short code 8070 and await automated confirmation."
        },
        {
          "@type": "HowToStep",
          "name": "Automated PLRA & NADRA Verification",
          "text": "Your identity and agricultural land ownership records are digitally validated."
        },
        {
          "@type": "HowToStep",
          "name": "Collect Card at Bank of Punjab",
          "text": "Visit the designated BOP branch with your CNIC to complete biometric verification and receive your Kisan Card."
