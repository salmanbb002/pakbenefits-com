        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Receive USD 100+ Home Remittances Monthly",
          "text": "Have an overseas sender transfer home remittances equivalent to at least USD 100 into your account every month."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Maintain Transfers for 3 Consecutive Months",
          "text": "Receive the qualifying USD 100+ remittance in all three consecutive months of the qualifying quarter (e.g., Oct, Nov, Dec)."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Automatic Digital Token Generation via 1LINK",
