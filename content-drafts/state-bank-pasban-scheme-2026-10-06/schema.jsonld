    {
      "@type": "FAQPage",
      "@id": "TODO:https://example.com/state-bank-pasban-scheme#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Pasban Remittance Reward Scheme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Pasban Remittance Reward Scheme is a market-based incentive program created by the Pakistan Banks’ Association under State Bank of Pakistan patronage. It rewards remittance recipients in Pakistan with PKR 16 billion in annual cash prizes for receiving money through formal banking channels."
          }
        },
        {
          "@type": "Question",
          "name": "Who qualifies for the quarterly Pasban lucky draws?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Any individual beneficiary in Pakistan who receives home remittances equivalent to at least USD 100 in each of three consecutive months of a quarter into a personal bank account or mobile wallet qualifies automatically."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to fill out a registration form or pay a fee to enter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No registration form, ticket purchase, or fee payment is required to join the Pasban scheme. Qualification is 100% free and handled automatically by participating banks through 1LINK transaction tracking."
          }
        },
        {
          "@type": "Question",
          "name": "What is the top prize amount in the State Bank Pasban Scheme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The top grand prize is PKR 100 million (Rs. 10 Crore), awarded to one winning beneficiary during each quarterly draw."
          }
        },
        {
          "@type": "Question",
          "name": "How many digital tokens does a remittance earn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Transfers from $100 to $149 earn 1 token; $150 to $249 earn 2 tokens; $250 to $349 earn 3 tokens, with +1 token for every additional $100."
          }
        },
        {
          "@type": "Question",
          "name": "Are Cash-Over-Counter (COC) cash pickups eligible for the draw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cash-Over-Counter cash pickups are not eligible for the Pasban draw. Remittances must be credited directly into a personal bank account or mobile wallet to qualify."
          }
        },
        {
          "@type": "Question",
          "name": "Are Roshan Digital Accounts (RDA) included in the Pasban Scheme?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roshan Digital Accounts are excluded from the Pasban Remittance Reward Scheme because RDA customers already access separate government investment incentives and tax benefits."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Pasban Scheme connected to the 8171 BISP portal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Pasban Scheme has no connection to the 8171 BISP SMS service. Any message asking for money or requesting an 8171 SMS payment for Pasban entry is a fraudulent scam."
          }
        },
        {
          "@type": "Question",
          "name": "When will the first Pasban Scheme draw take place?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The first official Pasban quarterly draw will take place on January 15, 2027, covering qualifying remittances received between October 1 and December 31, 2026."
          }
        },
        {
          "@type": "Question",
          "name": "How will winners receive their Pasban cash prizes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Winning cash prizes will be credited directly into the verified bank accounts or mobile wallets of the winning beneficiaries after computerized draw validation and tax deduction."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if a winning beneficiary has passed away?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If a winning customer dies before prize payment, the prize money is credited to legal heirs under standard bank inheritance protocols upon presenting a valid succession certificate."
          }
        },
        {
          "@type": "Question",
          "name": "Does the Sohni Dharti scheme still work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. SBP confirmed that the Sohni Dharti Remittance Programme has ended and its points do not carry over to the Pasban scheme."
          }
        }
      ]
    },
    {
